/**
 * AI Provider Configuration
 * 
 * This file defines the available LLM, TTS, and Image generation providers.
 * 
 * LLM Configuration:
 * - id: Unique identifier for the provider.
 * - name: Display name.
 * - bin: The binary/command to execute.
 * - model: (Optional) Specifies the model to use. 
 *          - If string: Appends ["--model", value] to the command arguments.
 *          - If array: Appends all elements directly to the command arguments (e.g., ["-m", "model-name"]).
 * - args: Arguments containing the "{{prompt}}" placeholder.
 * - sandbox-args: Arguments applied when sandbox mode is enabled.
 * - auto-args: Arguments applied when auto-allow is enabled.
 * - network-args: Arguments applied when network access is enabled.
 * - env: The environment variables which can be passed to the bin process from .env file
 * - disabled: (Optional) Set to true to exclude this provider from selection and listings.
 *             Defaults to false when omitted.
 * - background_only: (Optional) When true, the provider is hidden from the WebUI
 *                    LLM dropdown (web terminal). It is still available for
 *                    background LLM tasks selected via default.background_llm.
 */
{
  // Default provider selection used when no explicit provider is requested.
  default: {
    llm: 'opencode',
    doctor: 'opencode',
    // Optional: set to 'skill-pilot' to route non-tmux background LLM tasks
    // through the Skill Pilot agent.
    // background_llm: 'skill-pilot',
    tts: 'media-mcp',
    image: 'media-mcp',
  },

  // LLM CLI providers.
  llm: [
        // Claude Code via Claude-compatible API endpoint (disabled by default — configure env vars to enable)
    {
      id: 'claude-compat',
      name: 'SP Claude',
      bin: 'claude',
      model: '${SKILL_PILOT_CLAUDE_MODEL}',
      disabled: false,
      'sandbox-args': ['--settings', 'claude-sandbox-settings.json'],
      'auto-args': ['--dangerously-skip-permissions'],
      'network-args': [],
      args: [
        '--include-partial-messages',
        '--output-format=stream-json',
        '--verbose',
        '--print',
        '{{prompt}}',
      ],
      env: {
        'ANTHROPIC_BASE_URL': '${SKILL_PILOT_CLAUDE_BASE_URL}',
        'ANTHROPIC_AUTH_TOKEN': '${SKILL_PILOT_API_KEY}',
        'ANTHROPIC_API_KEY': '',
        'CLAUDE_CODE_ATTRIBUTION_HEADER': '0',
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}",
      },
      'exit-session': 'esc\nctrl+c\nctrl+c',
    },
    // OpenAI Codex via OpenAI-compatible API endpoint.
    // OpenAI Codex via OpenAI-compatible API endpoint using explicit
    // model_provider overrides for current Codex CLI releases.
    {
      id: 'codex-compat',
      name: 'SP Codex',
      bin: 'codex',
      model: '${SKILL_PILOT_MODEL}',
      disabled: false,
      'sandbox-args': ['--sandbox', 'workspace-write'],
      'auto-args': ['--ask-for-approval', 'never'],
      'network-args': ['--config', 'sandbox_workspace_write.network_access=true'],
      args: [
        'exec',
        '-c',
        'model_providers.skill_pilot.name="openai"',
        '-c',
        'model_providers.skill_pilot.base_url="${SKILL_PILOT_BASE_URL}"',
        '-c',
        'model_providers.skill_pilot.env_key="SKILL_PILOT_API_KEY"',
        '-c',
        'model_providers.skill_pilot.wire_api="responses"',
        '-c',
        'model_provider="skill_pilot"',
        '-c',
        'model_catalog_json="config/skill-pilot-codex-models.json"',
        '--json',
        '{{prompt}}',
      ],
      env: {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}",
      },
      'exit-session': 'esc\nctrl+c\nctrl+c',
    },
    // opencode usage: OPENCODE_CONFIG={ROOT-SKILL-PILOT}/config/opencode-yolo.json opencode
    // update opencode.json with the appropriate permissions and settings
    // opencode is no sandbox model, so be cautious when using it and ensure you have the necessary safeguards in place
    // stored OpenCode state at ~/.local/share/opencode/  
    {
      id: 'opencode',
      name: 'OpenCode',
      bin: 'opencode',
      model: 'opencode/big-pickle',
      args: ['--format', 'json', 'run', '{{prompt}}'],
      'terminal-args': ['--prompt', '{{prompt}}'],
      'exit-session': 'esc\nctrl+c\nctrl+c',
      env:{
        'PLAYWRIGHT_MCP_EXTENSION_TOKEN': '${PLAYWRIGHT_MCP_EXTENSION_TOKEN}',
      }
    },
    // claude usage: claude -p --settings {ROOT-SKILL-PILOT}/config/claude-sandbox-settings.json
    /*
    ANTHROPIC_BASE_URL
    ANTHROPIC_AUTH_TOKEN
    ANTHROPIC_API_KEY="" # Important: Must be explicitly empty
    */
    {
      id: 'claude',
      name: 'Claude',
      bin: 'claude',
      'sandbox-args': ['--settings', 'claude-sandbox-settings.json'],
      'auto-args': ['--dangerously-skip-permissions'],
      'network-args': [],
      args: [
        '--include-partial-messages',
        '--output-format=stream-json',
        '--verbose',
        '--print',
        '{{prompt}}',
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}",
      },
      'exit-session': 'esc\nctrl+c\nctrl+c',
    },
    /*
    # Using OpenAI codex with ENV vars below for any openai compatible api 
    OPENAI_API_KEY
    OPENAI_BASE_URL
    codex --model gpt-5.2
    */
    {
      id: 'codex',
      name: 'Codex',
      bin: 'codex',
      'sandbox-args': ['--sandbox', 'workspace-write'],
      'auto-args': ['--ask-for-approval', 'never'],
      'network-args': ['--config', 'sandbox_workspace_write.network_access=true'],
      args: [
        'exec',
        '--json',
        '{{prompt}}',
      ],
      env: {
        'PLAYWRIGHT_MCP_EXTENSION_TOKEN': '${PLAYWRIGHT_MCP_EXTENSION_TOKEN}',
      },
      'exit-session': 'esc\nctrl+c\nctrl+c',
    },
    {
      id: 'antigravity',
      name: 'Antigravity',
      bin: 'agy',
      'sandbox-args': ['--sandbox'],
      'auto-args': ['--dangerously-skip-permissions'],
      'network-args': [],
      args: [
        '--print',
        '{{prompt}}',
      ],
      'terminal-args': [
        '--prompt-interactive',
        '{{prompt}}',
      ],
      env: {
        'PLAYWRIGHT_MCP_EXTENSION_TOKEN': '${PLAYWRIGHT_MCP_EXTENSION_TOKEN}',
      },
      'exit-session': 'esc\nctrl+c\nctrl+c',
    },
    {
      id: 'skill-pilot',
      name: 'Skill Pilot Agent',
      bin: 'core/bin/skill-pilot-agent',
      background_only: true,
      'sandbox-args': ['--sandbox', 'yes'],
      'auto-args': ['--auto', 'yes'],
      'network-args': ['--network', 'no'],
      args: [
        '--model',
        '${SKILL_PILOT_MODEL}',
        '{{prompt}}',
      ],
      env: {
        'SKILL_PILOT_BASE_URL': '${SKILL_PILOT_BASE_URL}',
        'SKILL_PILOT_API_KEY': '${SKILL_PILOT_API_KEY}',
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${PLAYWRIGHT_MCP_EXTENSION_TOKEN}",
      },
    },

  ],

  // Text-to-speech providers.
  tts: [
    {
      id: 'skill-pilot',
      name: 'Skill Pilot TTS',
      model: 'skill-pilot-tts',
      instructions: 'Speak in a cheerful and positive tone.',
      format: 'mp3',
      voice: 'alloy',
    },
    {
      id: 'openai',
      name: 'OpenAI TTS',
      model: 'gpt-4o-mini-tts',
      instructions: 'Speak in a cheerful and positive tone.',
      format: 'wav',
      voice: 'alloy',
    },
    {
      id: 'gemini',
      name: 'Gemini TTS',
      model: 'gemini-2.5-flash-preview-tts',
      format: 'wav',
      voice: 'Kore',
    },
    {
      id: 'media-mcp',
      name: 'Media MCP Server - TTS',
      voices: {
        'angelina-en': {
            "emotion": "calm",
            "emotion_sample": "This is a calm and steady narration voice.",
            "ref_voice": "workspace/assets/custom-voices/angelina-speech-en-9s.mp3",
            "ref_emotion_voice": "workspace/assets/custom-voices/angelina-speech-en-9s.mp3",
        },
        'frank-cn': {
            "emotion": "calm",
            "emotion_sample": "This is a calm and steady narration voice.",
            "ref_voice": "workspace/assets/custom-voices/frank-cn-9s.mp3",
            "ref_emotion_voice": "workspace/assets/custom-voices/frank-cn-9s.mp3",
        }
      },
    },
  ],

  // Image generation providers.
  image: [
    {
      id: 'skill-pilot',
      name: 'Skill Pilot Image',
      model: 'skill-pilot-image',
      size: {
        'square': '1024x1024',
        'landscape': '1536x1024',
        'portrait': '1024x1536',
      },
      quality: 'low',
    },
    {
      id: 'openai',
      name: 'OpenAI Image',
      model: 'gpt-image-1',
      size: {
        'square': '1024x1024',
        'landscape': '1536x1024',
        'portrait': '1024x1536',
      },
      quality: 'low',
    },
    {
      id: 'gemini',
      name: 'Gemini Image',
      model: 'gemini-3.1-flash-image-preview',
      aspect_ratio: '2:3', // "1:1","1:4","1:8","2:3","3:2","3:4","4:1","4:3","4:5","5:4","8:1","9:16","16:9","21:9"
      resolution: "1K", // "512", "1K", "2K", "4K",
      size: {
        'square': '1024x1024',
        'landscape': '1280x720',
        'portrait': '720x1280',
      },
    },
    {
      id: 'media-mcp',
      name: 'Media MCP Server - Image',
      size: {
        'square': '1024x1024',
        'landscape': '1280x720',
        'portrait': '720x1280',
      },
    },
  ],
}
